# ====================================================================
# LifeLink - Docker Compose Environment Configuration Template
# ====================================================================
# Copy this file to .env before starting docker compose:
#   cp .env.docker.example .env
# ====================================================================

# --------------------------------------------------------------------
# Port Forwarding Configuration (Host:Container)
# --------------------------------------------------------------------
# Change host ports if you have port collisions on your machine:
FRONTEND_PORT=80
BACKEND_PORT=8080
MYSQL_PORT=3307

# --------------------------------------------------------------------
# MySQL Database Credentials
# --------------------------------------------------------------------
DB_ROOT_PASSWORD=strong_root_mysql_password_here
DB_USER=lifelink_user
DB_PASSWORD=strong_user_password_here

# --------------------------------------------------------------------
# Backend & JWT Security
# --------------------------------------------------------------------
# Generate a random 256-bit secret key (min 32 characters)
JWT_SECRET=replace_with_a_secure_random_key_of_at_least_32_characters_here
JWT_EXPIRATION_MS=86400000

# Hibernate Schema Management: update (development/staging), validate (production)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
SECURITY_LOG_LEVEL=INFO

# --------------------------------------------------------------------
# Frontend Build Arguments
# --------------------------------------------------------------------
# Leave empty so frontend uses relative URLs proxied by Nginx (/api and /ws)
# If using a separate domain or API gateway in production: https://api.yourdomain.com
VITE_API_BASE_URL=

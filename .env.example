# ====================================================================
# LifeLink — Environment Configuration Example (.env.example)
# ====================================================================
# Copy this file to .env or set these environment variables in your runtime
# environment. NEVER commit your actual .env file or real secrets to Git.
# ====================================================================

# --------------------------------------------------------------------
# 1. Backend Configuration (Spring Boot)
# --------------------------------------------------------------------
# Server port (Default: 8080)
PORT=8080

# MySQL Database connection parameters
DB_URL=jdbc:mysql://localhost:3306/blood_donor_system
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password_here

# Hibernate DDL Auto: update (for local dev), validate or none (for production)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT Security: Cryptographically secure 256-bit or 384-bit signing secret
# Minimum 32 characters for HMAC-SHA256, minimum 48 characters for HMAC-SHA384
JWT_SECRET=replace_this_with_a_secure_random_key_of_at_least_32_characters

# JWT token expiration in milliseconds (Default: 86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# Spring Security logging level: INFO or DEBUG
SECURITY_LOG_LEVEL=INFO

# --------------------------------------------------------------------
# 2. Frontend Configuration (Vite + React)
# --------------------------------------------------------------------
# Base URL for backend REST API.
# Leave empty in local development to use the built-in Vite dev proxy:
# (Frontend requests to /api and /ws will automatically proxy to http://localhost:8080)
# For production deployment with custom domain, set to: https://api.yourdomain.com
VITE_API_BASE_URL=

# ====================================================================
# SECURITY WARNING:
# Variables prefixed with VITE_ are embedded into public browser client bundles.
# NEVER place database passwords, private keys, or JWT signing secrets
# inside frontend environment variables or client-side code.
# ====================================================================

# ====================================================================
# LifeLink — Unified Environment Configuration Template (.env.example)
# ====================================================================
# Copy this file to .env before starting docker compose or running locally:
#   cp .env.example .env
# Generate secure random keys with: openssl rand -base64 48
# ====================================================================

# --- Port Forwarding (Host:Container) ---
FRONTEND_PORT=80
BACKEND_PORT=8080
MYSQL_PORT=3307
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- MySQL Database Configuration ---
DB_URL=jdbc:mysql://localhost:3306/blood_donor_system
DB_ROOT_PASSWORD=replace_with_strong_root_password
DB_USER=lifelink_user
DB_PASSWORD=replace_with_strong_db_password

# --- Redis Configuration ---
REDIS_HOST=localhost
REDIS_PASSWORD=replace_with_strong_redis_password

# --- RabbitMQ Configuration ---
RABBITMQ_HOST=localhost
RABBITMQ_USERNAME=lifelink_mq
RABBITMQ_PASSWORD=replace_with_strong_rabbitmq_password

# --- Spring Security & JWT Configuration ---
# Access token lifetime: 900000 ms (15 minutes). Must be <= 3600000 ms in prod.
JWT_SECRET=replace_with_secure_random_key_minimum_32_characters_long
JWT_EXPIRATION_MS=900000
RATE_LIMIT_TRUSTED_PROXIES=172.28.0.0/16,127.0.0.1,::1

# --- Admin Initial Setup (Optional: leave blank to disable auto-creation) ---
ADMIN_EMAIL=admin@lifelink.com
ADMIN_PASSWORD=replace_with_12plus_char_admin_password

# --- Profiles & Seeding ---
SPRING_PROFILES_ACTIVE=prod
DEMO_SEED_ENABLED=false
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
JPA_SHOW_SQL=false
SECURITY_LOG_LEVEL=INFO

# --- Frontend Build Arguments ---
# Leave blank to use relative paths (/api, /ws) reverse-proxied by Nginx
VITE_API_BASE_URL=
VITE_DEMO_MODE=false
